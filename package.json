    "sync:assets": "tsx scripts/sync-assets.ts",
    "build:search": "tsx scripts/build-search-index.ts",
    "generate:og": "tsx scripts/generate-og.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
