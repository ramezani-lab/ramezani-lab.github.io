    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.22",
    "lucide-react": "^1.37.0",
    "minisearch": "^7.2.0",
    "motion": "^12.23.12",
    "next": "16.3.3",
    "next-mdx-remote-client": "^2.1.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "^7.1.0",
